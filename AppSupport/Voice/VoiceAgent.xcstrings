    "Waiting for file selection": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Warte auf Dateiauswahl" } },
        "fr": { "stringUnit": { "state": "translated", "value": "En attente de la sélection du fichier" } },
        "es": { "stringUnit": { "state": "translated", "value": "Esperando selección de archivo" } }
      }
    },
    "Cancel import": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Import abbrechen" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Annuler l’importation" } },
        "es": { "stringUnit": { "state": "translated", "value": "Cancelar importación" } }
      }
    },
    "Cancelling import…": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Import wird abgebrochen…" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Annulation de l’importation…" } },
        "es": { "stringUnit": { "state": "translated", "value": "Cancelando importación…" } }
      }
    },
    "Import cancelled": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Import abgebrochen" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Importation annulée" } },
        "es": { "stringUnit": { "state": "translated", "value": "Importación cancelada" } }
      }
    },
    "Import failed": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Import fehlgeschlagen" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Échec de l’importation" } },
        "es": { "stringUnit": { "state": "translated", "value": "Error de importación" } }
      }
    },
    "Always approve volume edits": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Volumenbearbeitungen immer genehmigen" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Toujours autoriser les modifications du volume" } },
        "es": { "stringUnit": { "state": "translated", "value": "Permitir siempre las ediciones del volumen" } }
      }
    },
    "Save and restore the assistant conversation": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "KI-Gespräch speichern und wiederherstellen" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Enregistrer et restaurer la conversation" } },
        "es": { "stringUnit": { "state": "translated", "value": "Guardar y restaurar la conversación del asistente" } }
      }
    },
    "Confirm volume edits": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Volumenbearbeitungen bestätigen" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Confirmer les modifications du volume" } },
        "es": { "stringUnit": { "state": "translated", "value": "Confirmar las ediciones del volumen" } }
      }
    },
    "Could not save or restore the local conversation.": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Das lokale KI-Gespräch konnte nicht gespeichert oder geladen werden." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Impossible d’enregistrer ou de restaurer la conversation locale." } },
        "es": { "stringUnit": { "state": "translated", "value": "No se pudo guardar o restaurar la conversación local." } }
      }
    },
    "Could not remove the local conversation.": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Das gespeicherte KI-Gespräch konnte nicht gelöscht werden." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Impossible de supprimer la conversation locale." } },
        "es": { "stringUnit": { "state": "translated", "value": "No se pudo eliminar la conversación local." } }
      }
    },
    "Waiting for volume edit approval": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Warte auf Freigabe der Volumenbearbeitung" } },
        "fr": { "stringUnit": { "state": "translated", "value": "En attente de l’autorisation de modifier le volume" } },
        "es": { "stringUnit": { "state": "translated", "value": "Esperando autorización para editar el volumen" } }
      }
    },
    "Edited bricks are ready": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Bearbeitete Bricks sind fertig" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Les blocs modifiés sont prêts" } },
        "es": { "stringUnit": { "state": "translated", "value": "Los bloques editados están listos" } }
      }
    },
    "Edited bricks pending: %lld": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Bearbeitete Bricks ausstehend: %lld" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Blocs modifiés en attente : %lld" } },
        "es": { "stringUnit": { "state": "translated", "value": "Bloques editados pendientes: %lld" } }
      }
    },
    "Finishing edited bricks…": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Bearbeitete Bricks werden fertiggestellt…" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Finalisation des blocs modifiés…" } },
        "es": { "stringUnit": { "state": "translated", "value": "Finalizando los bloques editados…" } }
      }
    },
    "Erase this volume region?": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Diesen Volumenbereich löschen?" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Effacer cette région du volume ?" } },
        "es": { "stringUnit": { "state": "translated", "value": "¿Borrar esta región del volumen?" } }
      }
    },
    "Restore this volume region?": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Diesen Volumenbereich wiederherstellen?" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Restaurer cette région du volume ?" } },
        "es": { "stringUnit": { "state": "translated", "value": "¿Restaurar esta región del volumen?" } }
      }
    },
    "Erase region": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Bereich löschen" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Effacer la région" } },
        "es": { "stringUnit": { "state": "translated", "value": "Borrar región" } }
      }
    },
    "Restore region": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Bereich wiederherstellen" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Restaurer la région" } },
        "es": { "stringUnit": { "state": "translated", "value": "Restaurar región" } }
      }
    },
    "Brush stamps: %lld. Channels: %@. Bounds (XYZ in meters): %@ to %@. The original dataset is preserved.": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Pinselabdrücke: %lld. Kanäle: %@. Grenzen (XYZ in Metern): %@ bis %@. Der Originaldatensatz bleibt unverändert." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Empreintes : %lld. Canaux : %@. Limites (XYZ en mètres) : %@ à %@. Les données d’origine sont conservées." } },
        "es": { "stringUnit": { "state": "translated", "value": "Marcas del pincel: %lld. Canales: %@. Límites (XYZ en metros): %@ a %@. Se conservan los datos originales." } }
      }
    },
    "Workflow research (debug)": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Workflow-Forschung (Debug)" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Recherche sur les procédures (débogage)" } },
        "es": { "stringUnit": { "state": "translated", "value": "Investigación de flujos de trabajo (depuración)" } }
      }
    },
    "Allow before and after screenshots?": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Vorher-/Nachher-Screenshots erlauben?" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Autoriser les captures avant et après ?" } },
        "es": { "stringUnit": { "state": "translated", "value": "¿Permitir capturas antes y después?" } }
      }
    },
    "Allow for this demonstration": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Für diese Demonstration erlauben" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Autoriser pour cette démonstration" } },
        "es": { "stringUnit": { "state": "translated", "value": "Permitir para esta demostración" } }
      }
    },
    "The two render images may reveal dataset details. They are only included in a separate local export and are never sent to the workflow server.": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Die beiden Renderbilder können Details des Datensatzes zeigen. Sie werden nur in einen separaten lokalen Export aufgenommen und nicht an den Workflow-Server gesendet." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Les deux images peuvent révéler des détails des données. Elles figurent uniquement dans un export local séparé et ne sont pas envoyées au serveur." } },
        "es": { "stringUnit": { "state": "translated", "value": "Las dos imágenes pueden mostrar detalles de los datos. Solo se incluyen en una exportación local independiente y no se envían al servidor." } }
      }
    },
    "Demonstrate with before and after screenshots": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Mit Vorher-/Nachher-Screenshots demonstrieren" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Démontrer avec des captures avant et après" } },
        "es": { "stringUnit": { "state": "translated", "value": "Demostrar con capturas antes y después" } }
      }
    },
    "Export demonstration with screenshots": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Demonstration mit Screenshots exportieren" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Exporter la démonstration avec les captures" } },
        "es": { "stringUnit": { "state": "translated", "value": "Exportar demostración con capturas" } }
      }
    },
    "Cancel screenshot capture": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Screenshot-Aufnahme abbrechen" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Annuler la capture" } },
        "es": { "stringUnit": { "state": "translated", "value": "Cancelar captura" } }
      }
    },
    "Could not capture both screenshots": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Das Screenshot-Paar konnte nicht aufgenommen werden" } },
