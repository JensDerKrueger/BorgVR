{
  "sourceLanguage": "en",
  "strings": {
    "Choose saved visualization": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Gespeicherte Darstellung auswählen" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Choisir une visualisation enregistrée" } },
        "es": { "stringUnit": { "state": "translated", "value": "Elegir visualización guardada" } }
      }
    },
    "Delete saved edit state?": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Gespeicherten Editierstand löschen?" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Supprimer l’état d’édition enregistré ?" } },
        "es": { "stringUnit": { "state": "translated", "value": "¿Eliminar el estado de edición guardado?" } }
      }
    },
    "Delete edit state": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Editierstand löschen" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Supprimer l’état d’édition" } },
        "es": { "stringUnit": { "state": "translated", "value": "Eliminar estado de edición" } }
      }
    },
    "Unnamed edit state": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Unbenannter Editierstand" } },
        "fr": { "stringUnit": { "state": "translated", "value": "État d’édition sans nom" } },
        "es": { "stringUnit": { "state": "translated", "value": "Estado de edición sin nombre" } }
      }
    },
    "Delete “%@” (%@)? The original dataset and active edit state are kept.": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "„%@“ (%@) löschen? Der Originaldatensatz und der aktive Editierstand bleiben erhalten." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Supprimer « %@ » (%@) ? Le jeu de données original et l’état d’édition actif sont conservés." } },
        "es": { "stringUnit": { "state": "translated", "value": "¿Eliminar «%@» (%@)? Se conservan el conjunto original y el estado de edición activo." } }
      }
    },
    "Continue": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Weiter" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Continuer" } },
        "es": { "stringUnit": { "state": "translated", "value": "Continuar" } }
      }
    },
    "I completed part of the task, but couldn't finish or check the whole result.": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Ich habe einen Teil der Aufgabe ausgeführt. Den Rest konnte ich noch nicht erledigen oder abschließend prüfen." } },
        "fr": { "stringUnit": { "state": "translated", "value": "J’ai réalisé une partie de la tâche, mais je n’ai pas pu terminer ou vérifier l’ensemble du résultat." } },
        "es": { "stringUnit": { "state": "translated", "value": "He completado parte de la tarea, pero no he podido terminarla ni comprobar todo el resultado." } }
      }
    },
    "Confirmed volume edit commands: %lld.": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Bestätigte Volumenbearbeitungen: %lld." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Commandes de modification du volume confirmées : %lld." } },
        "es": { "stringUnit": { "state": "translated", "value": "Operaciones de edición del volumen confirmadas: %lld." } }
      }
    },
    "Would you like me to continue?": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Soll ich weitermachen?" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Voulez-vous que je continue ?" } },
        "es": { "stringUnit": { "state": "translated", "value": "¿Quieres que continúe?" } }
      }
    },
    "There is no paused task in this session. Tell me what you would like me to do next.": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "In dieser Sitzung gibt es keine pausierte Aufgabe. Sag mir, was ich als Nächstes tun soll." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Aucune tâche n’est en pause dans cette session. Dites-moi ce que vous voulez faire ensuite." } },
        "es": { "stringUnit": { "state": "translated", "value": "No hay ninguna tarea en pausa en esta sesión. Dime qué quieres que haga ahora." } }
      }
    },
    "I can't tell whether the last change was fully applied. Please check the view before continuing.": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Ich weiß nicht sicher, ob die letzte Änderung vollständig ausgeführt wurde. Bitte prüfe die Ansicht, bevor du weitermachst." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Je ne sais pas si la dernière modification a été entièrement appliquée. Vérifiez la vue avant de continuer." } },
        "es": { "stringUnit": { "state": "translated", "value": "No sé si el último cambio se aplicó por completo. Revisa la vista antes de continuar." } }
      }
    },
    "I made some changes, but can't safely continue. Please check the view.": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Ich habe Änderungen vorgenommen, kann aber nicht sicher weitermachen. Bitte prüfe die Ansicht." } },
        "fr": { "stringUnit": { "state": "translated", "value": "J’ai apporté des modifications, mais je ne peux pas continuer en toute sécurité. Vérifiez la vue." } },
        "es": { "stringUnit": { "state": "translated", "value": "He hecho algunos cambios, pero no puedo continuar con seguridad. Revisa la vista." } }
      }
    },
    "I couldn't complete the task and didn't make any changes. Try asking for one step at a time.": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Ich konnte die Aufgabe nicht ausführen und habe nichts verändert. Versuche es mit einem einzelnen Schritt." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Je n’ai pas pu accomplir la tâche et n’ai rien modifié. Essayez de demander une seule étape à la fois." } },
        "es": { "stringUnit": { "state": "translated", "value": "No he podido completar la tarea y no he hecho cambios. Prueba a pedirme un paso cada vez." } }
      }
    },
    "Choose the referenced file %@": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Referenzierte Datei %@ auswählen" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Choisir le fichier référencé %@" } },
        "es": { "stringUnit": { "state": "translated", "value": "Elegir el archivo referenciado %@" } }
      }
    },
    "Choose export folder for %@": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Exportordner für %@ auswählen" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Choisir le dossier d’exportation pour %@" } },
        "es": { "stringUnit": { "state": "translated", "value": "Elegir carpeta de exportación para %@" } }
      }
    },
    "Choose save folder for %@": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Speicherordner für %@ auswählen" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Choisir le dossier d’enregistrement pour %@" } },
        "es": { "stringUnit": { "state": "translated", "value": "Elegir carpeta de guardado para %@" } }
      }
    },
    "Choose reference volume for %@": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Referenzvolumen für %@ auswählen" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Choisir le volume de référence pour %@" } },
        "es": { "stringUnit": { "state": "translated", "value": "Elegir volumen de referencia para %@" } }
      }
    },
    "Choose moving volume for %@": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Zu registrierendes Volumen für %@ auswählen" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Choisir le volume à recaler pour %@" } },
        "es": { "stringUnit": { "state": "translated", "value": "Elegir volumen que se registrará para %@" } }
      }
    },
    "Choose source for %@": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Quelle für %@ auswählen" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Choisir la source pour %@" } },
        "es": { "stringUnit": { "state": "translated", "value": "Elegir origen para %@" } }
      }
    },
    "Imported with BorgVR": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Mit BorgVR importiert" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Importé avec BorgVR" } },
        "es": { "stringUnit": { "state": "translated", "value": "Importado con BorgVR" } }
      }
    },
    "Choose folder": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Ordner auswählen" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Choisir un dossier" } },
        "es": { "stringUnit": { "state": "translated", "value": "Elegir carpeta" } }
      }
    },
    "Choose file": {
