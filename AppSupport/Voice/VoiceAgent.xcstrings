        }
      }
    },
    "The request exceeds the AI model's context. Start a new conversation or shorten the request.": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The request exceeds the AI model's context. Start a new conversation or shorten the request." } },
