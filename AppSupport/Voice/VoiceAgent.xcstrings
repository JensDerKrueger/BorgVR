      }
    },
    "Check the HTTPS server address, access token and certificate.": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Prüfen Sie die HTTPS-Serveradresse, den Zugangsschlüssel und das Zertifikat." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Vérifiez l’adresse HTTPS du serveur, le jeton d’accès et le certificat." } },
        "es": { "stringUnit": { "state": "translated", "value": "Comprueba la dirección HTTPS del servidor, el token de acceso y el certificado." } }
      }
    },
    "The dataset or edit state changed. Start a new conversation.": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Der Datensatz oder Bearbeitungsstand hat sich geändert. Starten Sie ein neues Gespräch." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Le jeu de données ou l’état d’édition a changé. Commencez une nouvelle conversation." } },
        "es": { "stringUnit": { "state": "translated", "value": "El conjunto de datos o el estado de edición ha cambiado. Inicia una nueva conversación." } }
      }
    },
    "The agent did not respond in time. Start a new conversation.": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Der Agent hat nicht rechtzeitig geantwortet. Starten Sie ein neues Gespräch." } },
        "fr": { "stringUnit": { "state": "translated", "value": "L’assistant n’a pas répondu à temps. Commencez une nouvelle conversation." } },
        "es": { "stringUnit": { "state": "translated", "value": "El asistente no ha respondido a tiempo. Inicia una nueva conversación." } }
      }
    },
    "The render image could not be prepared for the agent.": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Das Renderbild konnte nicht für den Agenten aufbereitet werden." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Impossible de préparer l’image de rendu pour l’assistant." } },
        "es": { "stringUnit": { "state": "translated", "value": "No se ha podido preparar la imagen renderizada para el asistente." } }
      }
    },
    "Microphone and speech recognition permission are required.": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Der Zugriff auf Mikrofon und Spracherkennung muss erlaubt sein." } },
        "fr": { "stringUnit": { "state": "translated", "value": "L’accès au microphone et à la reconnaissance vocale doit être autorisé." } },
        "es": { "stringUnit": { "state": "translated", "value": "Se necesita permiso para acceder al micrófono y usar el reconocimiento de voz." } }
      }
    },
    "Speech recognition is unavailable. Try text input or change the on-device recognition setting.": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Spracherkennung ist nicht verfügbar. Verwenden Sie die Texteingabe oder ändern Sie die Einstellung zur lokalen Spracherkennung." } },
        "fr": { "stringUnit": { "state": "translated", "value": "La reconnaissance vocale n’est pas disponible. Saisissez votre message au clavier ou modifiez le réglage de reconnaissance vocale sur l’appareil." } },
        "es": { "stringUnit": { "state": "translated", "value": "El reconocimiento de voz no está disponible. Escribe el mensaje o cambia el ajuste de reconocimiento de voz en el dispositivo." } }
      }
    },
    "The agent connection failed. Check the server, token, certificate and network access.": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Die Verbindung zum Agenten ist fehlgeschlagen. Prüfen Sie Server, Zugangsschlüssel, Zertifikat und Netzwerkzugriff." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Impossible de se connecter à l’assistant. Vérifiez le serveur, le jeton, le certificat et l’accès au réseau." } },
        "es": { "stringUnit": { "state": "translated", "value": "No se ha podido conectar con el asistente. Comprueba el servidor, el token, el certificado y el acceso a la red." } }
      }
    },
    "The request exceeds the AI model's context. Start a new conversation or shorten the request.": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Die Anfrage überschreitet das Kontextlimit des KI-Modells. Beginnen Sie ein neues Gespräch oder kürzen Sie die Anfrage." } },
        "fr": { "stringUnit": { "state": "translated", "value": "La demande dépasse la capacité de contexte du modèle d’IA. Commencez une nouvelle conversation ou raccourcissez la demande." } },
        "es": { "stringUnit": { "state": "translated", "value": "La solicitud supera el límite de contexto del modelo de IA. Inicia una nueva conversación o acorta la solicitud." } }
      }
    },
    "Changes were applied, but the AI model's context was exhausted before the final check. Inspect the visualization and start a new conversation.": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Änderungen wurden ausgeführt, aber vor der abschließenden Prüfung war der Kontext des KI-Modells ausgeschöpft. Prüfen Sie die Darstellung und beginnen Sie ein neues Gespräch." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Des modifications ont été appliquées, mais le modèle d’IA a atteint sa limite de contexte avant la vérification finale. Vérifiez la visualisation, puis commencez une nouvelle conversation." } },
        "es": { "stringUnit": { "state": "translated", "value": "Se han aplicado cambios, pero el modelo de IA ha alcanzado su límite de contexto antes de la comprobación final. Revisa la visualización e inicia una nueva conversación." } }
      }
    },
    "Changes were applied, but the final check could not be completed. Inspect the visualization before continuing.": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Änderungen wurden ausgeführt, aber die abschließende Prüfung konnte nicht beendet werden. Prüfen Sie die Darstellung, bevor Sie fortfahren." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Des modifications ont été appliquées, mais la vérification finale n’a pas pu être menée à bien. Vérifiez la visualisation avant de continuer." } },
        "es": { "stringUnit": { "state": "translated", "value": "Se han aplicado cambios, pero no se ha podido completar la comprobación final. Revisa la visualización antes de continuar." } }
      }
    },
    "Changes were applied. I could not reliably assess the final view.": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Die Änderungen wurden ausgeführt. Ich konnte die abschließende Ansicht nicht zuverlässig beurteilen." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Les modifications ont été appliquées. Je n’ai pas pu évaluer la vue finale de manière fiable." } },
        "es": { "stringUnit": { "state": "translated", "value": "Se han aplicado los cambios. No he podido evaluar la vista final con fiabilidad." } }
      }
    },
    "It is unclear whether the last change was fully applied. Inspect the visualization before starting a new conversation; the command will not be repeated automatically.": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Es ist unklar, ob die letzte Änderung vollständig ausgeführt wurde. Prüfen Sie die Darstellung, bevor Sie ein neues Gespräch beginnen. Der Befehl wird nicht automatisch wiederholt." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Impossible de déterminer si la dernière modification a été entièrement appliquée. Vérifiez la visualisation avant de commencer une nouvelle conversation. La commande ne sera pas répétée automatiquement." } },
        "es": { "stringUnit": { "state": "translated", "value": "No está claro si el último cambio se ha aplicado por completo. Revisa la visualización antes de iniciar una nueva conversación. El comando no se repetirá automáticamente." } }
      }
    },
    "The command could not be completed. Inspect the visualization before continuing.": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Der Befehl konnte nicht abgeschlossen werden. Prüfen Sie die Darstellung, bevor Sie fortfahren." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Impossible de terminer la commande. Vérifiez la visualisation avant de continuer." } },
        "es": { "stringUnit": { "state": "translated", "value": "No se ha podido completar el comando. Revisa la visualización antes de continuar." } }
      }
    }
  },
  "version": "1.0"
}
