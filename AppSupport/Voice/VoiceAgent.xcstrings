    "Speech recognition is unavailable. Try text input or change the on-device recognition setting.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speech recognition is unavailable. Try text input or change the on-device recognition setting."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spracherkennung ist nicht verfügbar. Verwenden Sie die Texteingabe oder ändern Sie die Einstellung zur lokalen Spracherkennung."
          }
        }
      }
    },
    "The agent connection failed. Check the server, token, certificate and network access.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The agent connection failed. Check the server, token, certificate and network access."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verbindung zum Agenten ist fehlgeschlagen. Prüfen Sie Server, Zugangsschlüssel, Zertifikat und Netzwerkzugriff."
          }
        }
      }
    },
    "The request exceeds the AI model's context. Start a new conversation or shorten the request.": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The request exceeds the AI model's context. Start a new conversation or shorten the request." } },
        "de": { "stringUnit": { "state": "translated", "value": "Die Anfrage überschreitet das Kontextlimit des KI-Modells. Beginnen Sie ein neues Gespräch oder kürzen Sie die Anfrage." } }
      }
    },
    "Changes were applied, but the AI model's context was exhausted before the final check. Inspect the visualization and start a new conversation.": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Changes were applied, but the AI model's context was exhausted before the final check. Inspect the visualization and start a new conversation." } },
        "de": { "stringUnit": { "state": "translated", "value": "Änderungen wurden ausgeführt, aber vor der abschließenden Prüfung war der Kontext des KI-Modells ausgeschöpft. Prüfen Sie die Darstellung und beginnen Sie ein neues Gespräch." } }
      }
    },
    "Changes were applied, but the final check could not be completed. Inspect the visualization before continuing.": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Changes were applied, but the final check could not be completed. Inspect the visualization before continuing." } },
        "de": { "stringUnit": { "state": "translated", "value": "Änderungen wurden ausgeführt, aber die abschließende Prüfung konnte nicht beendet werden. Prüfen Sie die Darstellung, bevor Sie fortfahren." } }
