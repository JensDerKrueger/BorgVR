    "Send demonstration with view settings": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Demonstration mit Ansichtseinstellungen senden" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Envoyer la démonstration avec les réglages de vue" } },
        "es": { "stringUnit": { "state": "translated", "value": "Enviar demostración con ajustes de vista" } }
