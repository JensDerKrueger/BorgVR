    "Export demonstration with view settings": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Demonstration mit Ansichtseinstellungen exportieren" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Exporter la démonstration avec les réglages de vue" } },
        "es": { "stringUnit": { "state": "translated", "value": "Exportar demostración con ajustes de vista" } }
      }
    },
    "Export workflow state": {
      "extractionState": "manual",
