{
  "sourceLanguage": "en",
  "strings": {
    "Assistant options": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Assistentenoptionen" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Options de l’assistant" } },
        "es": { "stringUnit": { "state": "translated", "value": "Opciones del asistente" } }
      }
    },
    "Model profiles": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Modellprofile" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Profils de modèle" } },
        "es": { "stringUnit": { "state": "translated", "value": "Perfiles de modelo" } }
      }
    },
    "No model profiles": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Keine Modellprofile" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Aucun profil de modèle" } },
        "es": { "stringUnit": { "state": "translated", "value": "No hay perfiles de modelo" } }
      }
    },
    "Switch to another model?": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Modell wechseln?" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Changer de modèle ?" } },
        "es": { "stringUnit": { "state": "translated", "value": "¿Cambiar de modelo?" } }
      }
    },
    "Switch model": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Modell wechseln" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Changer de modèle" } },
        "es": { "stringUnit": { "state": "translated", "value": "Cambiar de modelo" } }
      }
    },
    "Switching models clears the current conversation.": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Beim Modellwechsel wird der bisherige Chat geleert." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Changer de modèle efface la conversation en cours." } },
        "es": { "stringUnit": { "state": "translated", "value": "Al cambiar de modelo se borra la conversación actual." } }
      }
    },
    "Add model profile": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Modellprofil hinzufügen" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Ajouter un profil de modèle" } },
        "es": { "stringUnit": { "state": "translated", "value": "Añadir un perfil de modelo" } }
      }
    },
    "Edit model profile": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Modellprofil bearbeiten" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Modifier le profil de modèle" } },
        "es": { "stringUnit": { "state": "translated", "value": "Editar el perfil de modelo" } }
      }
    },
    "Remove model profile": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Modellprofil entfernen" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Supprimer le profil de modèle" } },
        "es": { "stringUnit": { "state": "translated", "value": "Eliminar el perfil de modelo" } }
      }
    },
    "Profile name": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Profilname" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Nom du profil" } },
        "es": { "stringUnit": { "state": "translated", "value": "Nombre del perfil" } }
      }
    },
    "Test connection": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Testen" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Tester la connexion" } },
        "es": { "stringUnit": { "state": "translated", "value": "Probar la conexión" } }
      }
    },
    "OK": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "OK" } },
        "fr": { "stringUnit": { "state": "translated", "value": "OK" } },
        "es": { "stringUnit": { "state": "translated", "value": "Aceptar" } }
      }
    },
    "Model provider": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Modellanbieter" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Fournisseur du modèle" } },
        "es": { "stringUnit": { "state": "translated", "value": "Proveedor del modelo" } }
      }
    },
    "OpenAI model ID": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "OpenAI-Modell-ID" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Identifiant du modèle OpenAI" } },
        "es": { "stringUnit": { "state": "translated", "value": "ID del modelo de OpenAI" } }
      }
    },
    "Choose OpenAI model": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "OpenAI-Modell auswählen" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Choisir un modèle OpenAI" } },
        "es": { "stringUnit": { "state": "translated", "value": "Elegir un modelo de OpenAI" } }
      }
    },
    "Loading OpenAI models": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "OpenAI-Modelle werden geladen" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Chargement des modèles OpenAI…" } },
        "es": { "stringUnit": { "state": "translated", "value": "Cargando modelos de OpenAI…" } }
      }
    },
    "Search models": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Modelle suchen" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Rechercher des modèles" } },
        "es": { "stringUnit": { "state": "translated", "value": "Buscar modelos" } }
      }
    },
    "No matching models": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Keine passenden Modelle" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Aucun modèle correspondant" } },
        "es": { "stringUnit": { "state": "translated", "value": "No hay modelos que coincidan" } }
      }
    },
    "No compatible OpenAI models available": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Keine kompatiblen OpenAI-Modelle verfügbar" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Aucun modèle OpenAI compatible disponible" } },
        "es": { "stringUnit": { "state": "translated", "value": "No hay modelos de OpenAI compatibles disponibles" } }
      }
    },
    "Could not load models. Check the API key, its permissions and the network.": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Die Modelle konnten nicht geladen werden. Prüfe den API-Schlüssel, seine Berechtigungen und die Netzwerkverbindung." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Impossible de charger les modèles. Vérifiez la clé API, ses autorisations et la connexion réseau." } },
        "es": { "stringUnit": { "state": "translated", "value": "No se pudieron cargar los modelos. Comprueba la clave de API, sus permisos y la conexión de red." } }
      }
    },
    "vLLM HTTPS address": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "vLLM-HTTPS-Adresse" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Adresse HTTPS de vLLM" } },
        "es": { "stringUnit": { "state": "translated", "value": "Dirección HTTPS de vLLM" } }
      }
    },
    "OpenAI receives your request and relevant visualization state. Render images are sent only if you enable sharing below.": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "OpenAI erhält deine Anfrage und den relevanten Darstellungszustand. Renderbilder werden nur übertragen, wenn du sie unten freigibst." } },
        "fr": { "stringUnit": { "state": "translated", "value": "OpenAI reçoit votre demande et les informations pertinentes sur l’état de la visualisation. Les images de rendu ne sont envoyées que si vous activez le partage ci-dessous." } },
        "es": { "stringUnit": { "state": "translated", "value": "OpenAI recibe tu solicitud y la información pertinente sobre el estado de la visualización. Las imágenes renderizadas solo se envían si activas el uso compartido a continuación." } }
      }
    },
    "Share render images with OpenAI": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Renderbilder mit OpenAI teilen" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Partager les images de rendu avec OpenAI" } },
        "es": { "stringUnit": { "state": "translated", "value": "Compartir las imágenes renderizadas con OpenAI" } }
      }
    },
    "Import knowledge package": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Wissenspaket importieren" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Importer un ensemble de connaissances" } },
        "es": { "stringUnit": { "state": "translated", "value": "Importar un paquete de conocimientos" } }
      }
    },
    "Restore bundled knowledge": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Mitgeliefertes Wissen wiederherstellen" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Rétablir les connaissances fournies avec l’application" } },
        "es": { "stringUnit": { "state": "translated", "value": "Restaurar los conocimientos incluidos en la aplicación" } }
      }
    },
    "If on-device-only recognition is disabled, Apple may process microphone audio. Audio is never sent to the model server.": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Wenn die lokale Beschränkung aus ist, kann Apple Mikrofon-Audio verarbeiten. Der Modellserver erhält kein Audio." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Si la reconnaissance vocale n’est pas limitée à cet appareil, Apple peut traiter le son du microphone. Aucun son n’est envoyé au serveur du modèle." } },
        "es": { "stringUnit": { "state": "translated", "value": "Si la transcripción no se limita al dispositivo, Apple puede procesar el audio del micrófono. El audio nunca se envía al servidor del modelo." } }
      }
    },
    "Comparing volume previews…": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Vergleiche Volumenvorschauen…" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Comparaison des aperçus du volume…" } },
        "es": { "stringUnit": { "state": "translated", "value": "Comparando vistas previas del volumen…" } }
      }
    },
    "Next step": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Nächster Schritt" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Étape suivante" } },
        "es": { "stringUnit": { "state": "translated", "value": "Siguiente paso" } }
      }
    },
    "Response length": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Antwortlänge" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Longueur des réponses" } },
        "es": { "stringUnit": { "state": "translated", "value": "Longitud de las respuestas" } }
      }
    },
    "Concise": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Knapp" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Concise" } },
        "es": { "stringUnit": { "state": "translated", "value": "Breve" } }
      }
    },
    "Normal": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Normal" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Normale" } },
        "es": { "stringUnit": { "state": "translated", "value": "Normal" } }
      }
    },
    "Detailed": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Ausführlich" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Détaillée" } },
        "es": { "stringUnit": { "state": "translated", "value": "Detallada" } }
      }
    },
    "Noted.": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Verstanden." } },
        "fr": { "stringUnit": { "state": "translated", "value": "C’est noté." } },
        "es": { "stringUnit": { "state": "translated", "value": "Entendido." } }
      }
    },
    "I could not retain that information for later.": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Ich konnte mir diese Information nicht für später merken." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Je n’ai pas pu conserver cette information pour la suite." } },
        "es": { "stringUnit": { "state": "translated", "value": "No he podido guardar esa información para más adelante." } }
      }
    },
    "I could not determine a justified next step.": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Ich konnte keinen begründeten nächsten Schritt ableiten." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Je n’ai pas pu déterminer quelle étape était justifiée ensuite." } },
        "es": { "stringUnit": { "state": "translated", "value": "No he podido determinar cuál sería el siguiente paso adecuado." } }
      }
    },
    "I could not reliably assess the current view.": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Ich konnte die aktuelle Ansicht nicht zuverlässig beurteilen." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Je n’ai pas pu évaluer la vue actuelle de manière fiable." } },
        "es": { "stringUnit": { "state": "translated", "value": "No he podido evaluar la vista actual con fiabilidad." } }
      }
    },
    "No change applied": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Keine Änderung ausgeführt" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Aucune modification appliquée" } },
        "es": { "stringUnit": { "state": "translated", "value": "No se aplicó ningún cambio" } }
      }
    },
    "I could not find valid parameters for the requested change.": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Ich konnte keine gültigen Werte für die gewünschte Änderung ableiten." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Je n’ai pas trouvé de paramètres valides pour la modification demandée." } },
        "es": { "stringUnit": { "state": "translated", "value": "No he encontrado parámetros válidos para el cambio solicitado." } }
      }
    },
    "I could not establish a reliable change from the rendered images. I left the view unchanged.": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Aus den Renderbildern konnte ich keine verlässliche Änderung ableiten. Ich habe die Ansicht unverändert gelassen." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Les images de rendu ne m’ont pas permis de déterminer avec certitude quelle modification effectuer. J’ai laissé la vue inchangée." } },
        "es": { "stringUnit": { "state": "translated", "value": "Las imágenes renderizadas no me han permitido determinar con fiabilidad qué cambio hacer. He dejado la vista sin cambios." } }
      }
    },
    "I did not apply any change because I could not derive a reliable action.": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Ich habe nichts geändert, weil ich aus der Anfrage keine verlässliche Aktion ableiten konnte." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Je n’ai rien modifié, car je n’ai pas pu déterminer de manière fiable quelle action entreprendre." } },
        "es": { "stringUnit": { "state": "translated", "value": "No he cambiado nada porque no he podido determinar con fiabilidad qué acción realizar." } }
      }
    },
    "Confirmed changes: %lld": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Bestätigte Änderungen: %lld" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Modifications confirmées : %lld" } },
        "es": { "stringUnit": { "state": "translated", "value": "Cambios confirmados: %lld" } }
      }
    },
    "The assistant received an invalid decision or knowledge file.": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Der Assistent hat eine ungültige Entscheidung oder Wissensdatei erhalten." } },
        "fr": { "stringUnit": { "state": "translated", "value": "L’assistant a reçu une décision ou un fichier de connaissances non valide." } },
        "es": { "stringUnit": { "state": "translated", "value": "El asistente ha recibido una decisión o un archivo de conocimientos no válido." } }
      }
    },
    "BorgVR could not find the assistant knowledge package.": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "BorgVR konnte das Wissenspaket für den Assistenten nicht finden." } },
        "fr": { "stringUnit": { "state": "translated", "value": "BorgVR n’a pas trouvé l’ensemble de connaissances de l’assistant." } },
        "es": { "stringUnit": { "state": "translated", "value": "BorgVR no ha encontrado el paquete de conocimientos del asistente." } }
      }
    },
    "BorgVR could not read or validate the assistant knowledge package.": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "BorgVR konnte das Wissenspaket für den Assistenten nicht lesen oder prüfen." } },
        "fr": { "stringUnit": { "state": "translated", "value": "BorgVR n’a pas pu lire ni valider l’ensemble de connaissances de l’assistant." } },
        "es": { "stringUnit": { "state": "translated", "value": "BorgVR no ha podido leer o validar el paquete de conocimientos del asistente." } }
      }
    },
    "BorgVR could not prepare the current state for the assistant.": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "BorgVR konnte den aktuellen Zustand nicht für den Assistenten aufbereiten." } },
        "fr": { "stringUnit": { "state": "translated", "value": "BorgVR n’a pas pu préparer l’état actuel pour l’assistant." } },
        "es": { "stringUnit": { "state": "translated", "value": "BorgVR no ha podido preparar el estado actual para el asistente." } }
      }
    },
    "The model server returned an unexpected response.": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Der Modellserver hat eine unerwartete Antwort geliefert." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Le serveur du modèle a renvoyé une réponse inattendue." } },
        "es": { "stringUnit": { "state": "translated", "value": "El servidor del modelo ha devuelto una respuesta inesperada." } }
      }
    },
    "The model reached its output limit before BorgVR could use its decision.": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Das Modell hat sein Ausgabelimit erreicht, bevor BorgVR seine Entscheidung verwenden konnte." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Le modèle a atteint sa limite de sortie avant que BorgVR puisse utiliser sa décision." } },
        "es": { "stringUnit": { "state": "translated", "value": "El modelo ha alcanzado su límite de salida antes de que BorgVR pudiera usar su decisión." } }
      }
    },
    "The model did not return a BorgVR decision.": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Das Modell hat keine Entscheidung für BorgVR zurückgegeben." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Le modèle n’a pas renvoyé de décision à BorgVR." } },
        "es": { "stringUnit": { "state": "translated", "value": "El modelo no ha devuelto ninguna decisión a BorgVR." } }
      }
    },
    "The model returned a decision that BorgVR could not read.": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Das Modell hat eine Entscheidung geliefert, die BorgVR nicht lesen konnte." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Le modèle a renvoyé une décision que BorgVR n’a pas pu lire." } },
        "es": { "stringUnit": { "state": "translated", "value": "El modelo ha devuelto una decisión que BorgVR no ha podido leer." } }
      }
    },
    "The model ended the request or asked a question without supplying text.": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Das Modell hat den Auftrag beendet oder eine Rückfrage angekündigt, aber keinen Text mitgeliefert." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Le modèle a mis fin à la demande ou posé une question sans fournir de texte." } },
        "es": { "stringUnit": { "state": "translated", "value": "El modelo ha dado por terminada la solicitud o ha planteado una pregunta sin proporcionar texto." } }
      }
    },
    "The assistant could not make progress on this request. No changes were confirmed.": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Der Assistent konnte bei dieser Anfrage nicht weiterkommen. Es wurden keine Änderungen bestätigt." } },
        "fr": { "stringUnit": { "state": "translated", "value": "L’assistant n’a pas pu avancer sur cette demande. Aucune modification n’a été confirmée." } },
        "es": { "stringUnit": { "state": "translated", "value": "El asistente no ha podido avanzar con esta solicitud. No se ha confirmado ningún cambio." } }
      }
    },
    "The model declined this request. No further action was taken.": {
      "extractionState": "manual",
      "localizations": {
