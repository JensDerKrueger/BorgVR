    "Import knowledge package": { "extractionState": "manual", "localizations": { "de": { "stringUnit": { "state": "translated", "value": "Wissenspaket importieren" } } } },
    "Restore bundled knowledge": { "extractionState": "manual", "localizations": { "de": { "stringUnit": { "state": "translated", "value": "Mitgeliefertes Wissen wiederherstellen" } } } },
    "If on-device-only recognition is disabled, Apple may process microphone audio. Audio is never sent to the model server.": { "extractionState": "manual", "localizations": { "de": { "stringUnit": { "state": "translated", "value": "Wenn die lokale Beschränkung aus ist, kann Apple Mikrofon-Audio verarbeiten. Der Modellserver erhält kein Audio." } } } },
