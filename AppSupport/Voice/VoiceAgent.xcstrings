    "Confirmed changes: %lld": { "extractionState": "manual", "localizations": { "de": { "stringUnit": { "state": "translated", "value": "Bestätigte Änderungen: %lld" } } } },
    "The assistant received an invalid decision or knowledge file.": { "extractionState": "manual", "localizations": { "de": { "stringUnit": { "state": "translated", "value": "Der Assistent hat eine ungültige Entscheidung oder Wissensdatei erhalten." } } } },
    "The model declined this request. No further action was taken.": { "extractionState": "manual", "localizations": { "de": { "stringUnit": { "state": "translated", "value": "Das Modell hat diese Anfrage abgelehnt. Es wurde nichts Weiteres ausgeführt." } } } },
