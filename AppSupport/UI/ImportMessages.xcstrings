    "Close the current dataset before importing another dataset.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close the current dataset before importing another dataset."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließen Sie den aktuellen Datensatz, bevor Sie einen weiteren importieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fermez le jeu de données actuel avant d’en importer un autre."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cierre el conjunto de datos actual antes de importar otro."
          }
        }
      }
    },
    "An import is still running. Wait until it finishes or cancellation completes.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An import is still running. Wait until it finishes or cancellation completes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Import läuft noch. Warten Sie, bis er beendet oder vollständig abgebrochen wurde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une importation est encore en cours. Attendez sa fin ou la fin de son annulation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay una importación en curso. Espere a que termine o se complete su cancelación."
          }
        }
      }
    },
