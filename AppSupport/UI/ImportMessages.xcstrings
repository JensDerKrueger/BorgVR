          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, canal %ld: rango finito original %@; cuantificación a UInt16 (0 ... 65535). Constante/NaN/-Infinito -> 0; +Infinito -> 65535."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
