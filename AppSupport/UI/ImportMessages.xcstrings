    "Ignoring --size-x: the source supplies physical voxel spacing. Use --force-size-x to override it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignoring --size-x: the source supplies physical voxel spacing. Use --force-size-x to override it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "--size-x wird ignoriert: Die Quelle enthält physische Voxelabstände. Mit --force-size-x können diese überschrieben werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ignora --size-x: la fuente incluye el espaciado físico de los vóxeles. Use --force-size-x para sustituirlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "--size-x est ignoré : la source fournit l’espacement physique des voxels. Utilisez --force-size-x pour le remplacer."
