    "UVF: shifting signed %ld-bit samples into the unsigned range by flipping the sign bit.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "UVF: shifting signed %ld-bit samples into the unsigned range by flipping the sign bit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "UVF: Vorzeichenbehaftete %ld-Bit-Werte werden durch Umkehren des Vorzeichenbits in den vorzeichenlosen Bereich verschoben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "UVF: desplazando valores de %ld bits con signo al rango sin signo invirtiendo el bit de signo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "UVF : décalage des valeurs signées sur %ld bits dans la plage non signée en inversant le bit de signe."
          }
        }
      }
    },
    "%@ channel %ld: original finite range %@; quantizing to UInt16 (0 ... 65535). Constant/NaN/-Infinity -> 0; +Infinity -> 65535.": {
