/* Info screen: intro title */
"info_intro_title" = "Bienvenido a la aplicación BorgVR.";

/* Info screen: intro body text */
"info_intro_body" = "BorgVR es una **aplicación de renderizado volumétrico bricked out-of-core y ray-guided** diseñada para **realidad virtual y aumentada** en la plataforma **Apple Vision Pro**. El sistema ahora admite flujos de trabajo móviles, de escritorio y espaciales; varios usuarios pueden colaborar mediante **SharePlay** sobre los mismos conjuntos de datos en dispositivos compatibles. BorgVR usa **Swift** y **Metal** para un renderizado de alto rendimiento y es un proyecto de **código abierto**.";

/* Info screen: publications intro */
"info_publications_intro" = "Esta aplicación forma parte de un **proyecto de investigación en curso** que explora técnicas avanzadas de renderizado volumétrico. Nuestro trabajo se ha publicado en los siguientes artículos:";

/* Info screen: first paper title (link text) */
"info_pub1_title" = "**Investigating the Apple Vision Pro Spatial Computing Platform for GPU-Based Volume Visualization**";

/* Info screen: first paper venue */
"info_pub1_venue" = "Presentado en **IEEE Visualization 2024**.";

/* Info screen: second paper title (link text) */
"info_pub2_title" = "**An Investigation of the Apple Vision Pro for Out-of-Core Ray-Guided Volume Rendering with BorgVR**";

/* Info screen: second paper venue */
"info_pub2_venue" = "Presentado en **VMV 2025**.";

/* Info screen: concluding body text */
"info_conclusion_body" = "Aunque el estudio original introdujo la tecnología central, BorgVR representa ahora un **renderizador volumétrico más sofisticado**, que combina **Ray-Guided Volume Rendering** con funciones modernas multiplataforma.";

