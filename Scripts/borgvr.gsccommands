# BorgVR-specific commands for Graphics Script Editor.
# The editor already knows the base DSL and base tool commands:
# log, logfile, clearlog, logtime, setdir, screenshot, resize, setfpswindow,
# logfps, setbackground, reset, quit, repeat, if, set, and related basics.
# Types: bool, int, int64, float, double, string, restString.
# bool accepts: 1/0, true/false, on/off, yes/no.

# Interactive value functions
# Use them on the right side of set, for example:
# set name input "Enter a name"
# set file fileinput "Choose a file"
# set folder dirinput "Choose a folder"
input(string) -> string
fileinput(string) -> string
dirinput(string) -> string

# Dataset import
# Relative paths are resolved below the current script output directory.
importfile(string,string,string)
importdirectory(string,string,string)
# Export one BorgVR LoD as an uncompressed inline NRRD; LoD 0 is full resolution.
exportdataset(string,string,int)
# Export the current dataset as an OBJ isosurface. The optional value overrides the current
# normalized isovalue and must be in the range 0...1.
exportisosurface(string)
exportisosurface(string,float)
setimportbricksize(int)
setimportoverlap(int)
# Border modes: 0 = zeroes, 1 = clamp to border, 2 = repeat.
setbordermode(int)

# Dataset control
opendataset(string)

# Capture and synchronization
waitframes(int)
waitloaded()
waitloaded(int)
waitidle()
waitidle(int)

# Rendering state
rendermode(string)
setmethod(int)
background(string)
background(string,double,double,double)
background(string,double,double,double,double,double,double)

# Transform
resetrotation()
setrotationquaternion(float, float, float, float)
addrotationx(float)
addrotationy(float)
addrotationz(float)
settranslation(float,float)
zoom(float)
setscale(float)

# Clipping and isovalue
clip(float,float,float,float,float,float)
resetclip()
isovalue(float)
isovalueNormalized(float)

# Transfer function
settffile(string)
loadtf(string)
savetffile(string)
savetf(string)
# Replaces one complete RGBA transfer-function channel from base64-encoded sample bytes.
settransferfunction(int,string)
resettf()

# Lighting (RGB components use the 0...1 range)
setlightdirection(float,float,float)
setambientlight(float,float,float)
setdiffuselight(float,float,float)
setspecularlight(float,float,float)
resetlighting()

# Local annotation visibility. These commands never delete data.
hideobjects(bool)
hidemeasurements(bool)

# Markers
# Put names and paths containing spaces in single or double quotes.
# Sphere: name, position xyz, radius, RGB
addspheremarker(string,float,float,float,float,float,float,float)
# Directional sphere: name, position xyz, radius, RGB, direction-origin xyz
adddirectionalmarker(string,float,float,float,float,float,float,float,float,float,float)
# Stroke: name, radius, RGB, followed by one or more xyz point triples
addstrokemarker(string,float,float,float,float,restString)
removemarker(string)
clearmarkers()
# The optional bool selects replace (true) or merge (false).
loadmarkers(string)
loadmarkers(string,bool)
savemarkers(string)

# Deterministic annotation commands used by interaction recording.
# These commands create or replace the entry with the supplied UUID.
setspheremarker(string,string,float,float,float,float,float,float,float,float,bool,float,float,float)
# UUID, name, RGBA, followed by xyzw point groups where w is the point radius.
setstrokemarker(string,string,float,float,float,float,restString)
# Instance UUID, asset UUID, name, translation xyz, quaternion xyzw, scale xyz, visible.
setmeshinstance(string,string,string,float,float,float,float,float,float,float,float,float,float,bool)
removeobject(string)
clearobjects()

# Measurement UUID, kind (length/area/volume), name, followed by point UUID/xyz groups.
setmeasurement(string,string,string,restString)
removemeasurement(string)
clearmeasurements()

# Performance
resetfps()
setDisplaySync(bool)
