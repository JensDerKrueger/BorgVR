"Render Mode" = "Render Mode";
"Interaction" = "Interaction";

"info_paragraph_intro" = "BorgVR is a **Bricked Out-of-Core, Ray-Guided Volume Rendering Application** designed for **Virtual and Augmented Reality** on the **Apple Vision Pro** platform. The system has since been ported to **iOS** and **macOS**; multiple users can collaborate through **SharePlay** on the same datasets across iPhone, iPad, Mac, and Apple Vision Pro. BorgVR uses **Swift** and **Metal** for high-performance rendering and is an **open-source** project.";

"info_paragraph_papers" = "This application is part of an **ongoing research project**, exploring advanced techniques in volume rendering. Our work has been published in the following papers:";

"info_paper1_title" = "**Investigating the Apple Vision Pro Spatial Computing Platform for GPU-Based Volume Visualization**";
"info_paper1_venue" = "Presented at **IEEE Visualization 2024**.";

"info_paper2_title" = "**An Investigation of the Apple Vision Pro for Out-of-Core Ray-Guided Volume Rendering with BorgVR**";
"info_paper2_venue" = "Presented at **VMV 2025**.";

"info_paragraph_future" = "While the original study introduced the core technology, BorgVR now represents a **more sophisticated volume renderer**, combining **Ray-Guided Volume Rendering** with modern **iOS**, **visionOS**, and **macOS** features.";

"info_button_close" = "Close";

"info_footer_years" = "© 2024–2026";
"info_footer_cgvis" = "CGVIS Duisburg, Germany";

