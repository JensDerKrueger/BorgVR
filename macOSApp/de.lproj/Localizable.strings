"info_paragraph_intro" = "BorgVR ist eine **Bricked Out-of-Core, Ray-Guided Volume Rendering Anwendung**, entwickelt für **Virtual und Augmented Reality** auf der **Apple Vision Pro** Plattform. Inzwischen unterstützt das System mobile, Desktop- und Spatial-Workflows; mehrere Nutzerinnen und Nutzer können über **SharePlay** gemeinsam auf unterstützten Geräten mit denselben Datensätzen arbeiten. BorgVR nutzt **Swift** und **Metal** für hochperformantes Rendering und ist ein **Open-Source**-Projekt.";

"info_paragraph_papers" = "Diese Anwendung ist Teil eines **laufenden Forschungsprojekts**, das fortgeschrittene Verfahren im Volume Rendering untersucht. Unsere Arbeiten wurden in den folgenden Veröffentlichungen präsentiert:";

"info_paper1_title" = "**Investigating the Apple Vision Pro Spatial Computing Platform for GPU-Based Volume Visualization**";
"info_paper1_venue" = "Präsentiert auf der **IEEE Visualization 2024**.";

"info_paper2_title" = "**An Investigation of the Apple Vision Pro for Out-of-Core Ray-Guided Volume Rendering with BorgVR**";
"info_paper2_venue" = "Präsentiert auf der **VMV 2025**.";

"info_paragraph_future" = "Während die ursprüngliche Studie die grundlegende Technologie eingeführt hat, stellt BorgVR inzwischen einen **deutlich weiterentwickelten Volume Renderer** dar, der **Ray-Guided Volume Rendering** mit modernen plattformübergreifenden Funktionen verbindet.";

"info_button_close" = "Schließen";

"info_footer_years" = "© 2024–2026";
"info_footer_cgvis" = "CGVIS Duisburg";

