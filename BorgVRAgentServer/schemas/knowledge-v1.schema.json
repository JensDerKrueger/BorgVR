{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BorgVR knowledge and learner checkpoint v1 (draft)",
  "oneOf": [{ "$ref": "#/$defs/bundle" }, { "$ref": "#/$defs/checkpoint" }],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,95}$" },
    "revision": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
    "label": { "type": "string", "minLength": 1, "maxLength": 240 },
    "text": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,47}$" },
    "review": { "enum": ["pending", "approved", "rejected"] },
    "bundle": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "version", "entries"],
      "properties": {
        "kind": { "const": "knowledge_bundle" },
        "version": { "const": 1 },
        "entries": { "$ref": "#/$defs/entries" }
      }
    },
    "entries": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/entry" } },
    "entry": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "revision", "source", "situation", "goal"],
      "anyOf": [{ "required": ["guidance"] }, { "required": ["procedure"] }],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "revision": { "$ref": "#/$defs/revision" },
        "source": { "enum": ["bundled", "learner", "user"] },
        "situation": { "$ref": "#/$defs/label" },
        "goal": { "$ref": "#/$defs/label" },
        "contexts": { "type": "array", "uniqueItems": true, "items": { "enum": ["start_menu", "dataset_ready", "dataset_opened"] } },
        "keywords": { "type": "array", "maxItems": 12, "items": { "$ref": "#/$defs/label" } },
        "evidence_ids": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "guidance": { "$ref": "#/$defs/guidance" },
        "procedure": { "$ref": "#/$defs/procedure" }
      }
    },
    "guidance": {
      "type": "object", "additionalProperties": false,
      "required": ["revision", "review", "text"],
      "properties": {
        "revision": { "$ref": "#/$defs/revision" },
        "review": { "$ref": "#/$defs/review" },
        "text": { "$ref": "#/$defs/text" }
      }
    },
    "procedure": {
      "type": "object", "additionalProperties": false,
      "required": ["revision", "review", "language", "input_schema", "output_schema", "limits", "program"],
      "properties": {
        "revision": { "$ref": "#/$defs/revision" },
        "review": { "$ref": "#/$defs/review" },
        "language": { "const": "borgvr-flow-v1" },
        "announcement_hint": { "$ref": "#/$defs/label" },
        "input_schema": { "type": "object" },
        "output_schema": { "type": "object" },
        "limits": {
          "type": "object", "additionalProperties": false, "required": ["max_calls", "timeout_seconds"],
          "properties": {
            "max_calls": { "type": "integer", "minimum": 1, "maximum": 128 },
            "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 300 }
          }
        },
        "program": { "$ref": "#/$defs/block" }
      }
    },
    "value": {
      "type": "object", "additionalProperties": false, "minProperties": 1, "maxProperties": 1,
      "properties": {
        "literal": true,
        "ref": { "type": "string", "maxLength": 192, "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$" }
      }
    },
    "block": {
      "type": "object", "additionalProperties": false, "required": ["steps", "yield"],
      "properties": {
        "steps": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/step" } },
        "yield": { "$ref": "#/$defs/value" }
      }
    },
    "step": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "operation", "version", "args", "as"],
          "properties": {
            "kind": { "const": "call" },
            "operation": { "type": "string", "maxLength": 96, "pattern": "^(compute|app|procedure)(\\.[a-z][a-z0-9_]*)+$" },
            "version": { "$ref": "#/$defs/revision" },
            "args": { "type": "object", "maxProperties": 24, "propertyNames": { "$ref": "#/$defs/name" }, "additionalProperties": { "$ref": "#/$defs/value" } },
            "as": { "$ref": "#/$defs/name" }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "test", "then", "else", "as"],
          "properties": {
            "kind": { "const": "if" }, "test": { "$ref": "#/$defs/value" },
            "then": { "$ref": "#/$defs/block" }, "else": { "$ref": "#/$defs/block" },
            "as": { "$ref": "#/$defs/name" }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "items", "item", "limit", "body", "as"],
          "properties": {
            "kind": { "const": "for_each" }, "items": { "$ref": "#/$defs/value" },
            "item": { "$ref": "#/$defs/name" }, "limit": { "type": "integer", "minimum": 1, "maximum": 64 },
            "body": { "$ref": "#/$defs/block" }, "as": { "$ref": "#/$defs/name" }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "initial", "state", "limit", "body", "until", "as"],
          "properties": {
            "kind": { "const": "iterate" }, "initial": { "$ref": "#/$defs/value" },
            "state": { "$ref": "#/$defs/name" }, "limit": { "type": "integer", "minimum": 1, "maximum": 8 },
            "body": { "$ref": "#/$defs/block" }, "until": { "$ref": "#/$defs/value" },
            "as": { "$ref": "#/$defs/name" }
          }
        }
      ]
    },
    "checkpoint": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "version", "lineage_id", "revision", "entries", "hypotheses", "evidence"],
      "properties": {
        "kind": { "const": "learner_checkpoint" }, "version": { "const": 1 },
        "lineage_id": { "$ref": "#/$defs/id" }, "revision": { "$ref": "#/$defs/revision" },
        "entries": { "$ref": "#/$defs/entries" },
        "hypotheses": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/hypothesis" } },
        "evidence": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/evidence" } }
      }
    },
    "hypothesis": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "revision", "claim", "status", "next_steps", "evidence"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "revision": { "$ref": "#/$defs/revision" },
        "claim": { "$ref": "#/$defs/text" }, "status": { "enum": ["collecting", "testing"] },
        "next_steps": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/label" } },
        "entry": {
          "type": "object", "additionalProperties": false, "required": ["id", "revision"],
          "properties": { "id": { "$ref": "#/$defs/id" }, "revision": { "$ref": "#/$defs/revision" } }
        },
        "evidence": {
          "type": "array", "maxItems": 64,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "relation"],
            "properties": { "id": { "$ref": "#/$defs/id" }, "relation": { "enum": ["supports", "contradicts", "inconclusive"] } }
          }
        }
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "episode_id", "kind", "summary", "observation"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "episode_id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["command_trace", "user_feedback", "render_comparison", "fixture_result"] },
        "summary": { "$ref": "#/$defs/text" },
        "observation": { "type": "object" },
        "images": {
          "type": "array", "maxItems": 2,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["role", "png_base64"],
            "properties": {
              "role": { "enum": ["before", "after", "reference"] },
              "png_base64": { "type": "string", "minLength": 4, "maxLength": 2796204, "contentEncoding": "base64", "contentMediaType": "image/png" }
            }
          }
        }
      }
    }
  }
}
