    "Bei `.dat` und `.nhdr` muss iOS auch Zugriff auf die referenzierte Rohdatei bekommen." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei `.dat` und `.nhdr` muss iOS auch Zugriff auf die referenzierte Rohdatei bekommen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For `.dat` and `.nhdr`, iOS also needs access to the referenced raw data file."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para `.dat` y `.nhdr`, iOS también necesita acceso al archivo de datos sin procesar referenciado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour `.dat` et `.nhdr`, iOS doit aussi accéder au fichier de données brutes référencé."
          }
        }
      }
    },
