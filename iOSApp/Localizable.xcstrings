        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta aplicación forma parte de un **proyecto de investigación en curso** sobre técnicas avanzadas de renderizado volumétrico. Nuestro trabajo se ha publicado en los siguientes artículos:"
          }
        },
