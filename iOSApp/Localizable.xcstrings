    "info_conclusion_body" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Während die ursprüngliche Studie die grundlegende Technologie eingeführt hat, stellt BorgVR inzwischen einen **deutlich weiterentwickelten Volumenrenderer** dar, der **Ray-Guided Volume Rendering** mit modernen Funktionen von **iOS**, **visionOS** und **macOS** kombiniert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "While the original study introduced the core technology, BorgVR now represents a **more sophisticated volume renderer**, combining **Ray-Guided Volume Rendering** with modern **iOS**, **visionOS**, and **macOS** features."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aunque el estudio original introdujo la tecnología básica, BorgVR es ahora un **renderizador volumétrico mucho más avanzado** que combina **Ray-Guided Volume Rendering** con funciones modernas de **iOS**, **visionOS** y **macOS**."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alors que l’étude initiale présentait la technologie de base, BorgVR est désormais un **moteur de rendu volumique nettement plus avancé** qui associe le **Ray-Guided Volume Rendering** à des fonctionnalités modernes d’**iOS**, de **visionOS** et de **macOS**."
          }
        }
      }
    },
