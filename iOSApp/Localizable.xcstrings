    "info_heading" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Über BorgVR"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "About BorgVR"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acerca de BorgVR"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À propos de BorgVR"
          }
        }
      }
    },
    "info_intro_body" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BorgVR ist eine **Bricked Out-of-Core, Ray-Guided Volume Rendering Anwendung**, die für **Virtual und Augmented Reality** auf der **Apple Vision Pro** Plattform entwickelt wurde. Inzwischen wurde das System auf **iOS** und **macOS** portiert; mehrere Nutzerinnen und Nutzer können über **SharePlay** gemeinsam auf iPhone, iPad, Mac und Apple Vision Pro mit denselben Datensätzen arbeiten. BorgVR nutzt **Swift** und **Metal** für hochperformantes Rendering und ist ein **Open-Source**-Projekt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BorgVR is a **Bricked Out-of-Core, Ray-Guided Volume Rendering Application** designed for **Virtual and Augmented Reality** on the **Apple Vision Pro** platform. The system has since been ported to **iOS** and **macOS**; multiple users can collaborate through **SharePlay** on the same datasets across iPhone, iPad, Mac, and Apple Vision Pro. BorgVR uses **Swift** and **Metal** for high-performance rendering and is an **open-source** project."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BorgVR es una aplicación de **renderizado volumétrico bricked out-of-core y ray-guided** diseñada para **realidad virtual y aumentada** en la plataforma **Apple Vision Pro**. Desde entonces, el sistema se ha portado a **iOS** y **macOS**; varias personas pueden colaborar mediante **SharePlay** con los mismos conjuntos de datos en iPhone, iPad, Mac y Apple Vision Pro. BorgVR usa **Swift** y **Metal** para renderizado de alto rendimiento y es un proyecto de **código abierto**."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BorgVR est une application de **rendu volumique bricked out-of-core et ray-guided** conçue pour la **réalité virtuelle et augmentée** sur la plateforme **Apple Vision Pro**. Le système a depuis été porté sur **iOS** et **macOS** ; plusieurs personnes peuvent collaborer via **SharePlay** sur les mêmes jeux de données avec iPhone, iPad, Mac et Apple Vision Pro. BorgVR utilise **Swift** et **Metal** pour un rendu haute performance et constitue un projet **open source**."
          }
        }
      }
    },
